{
  "name": "guardrails-lab-ts",
  "version": "0.4.0",
  "private": true,
  "description": "A small order service: the TypeScript version of the guardrails lab",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "check": "node scripts/check.mjs",
    "stages": "node scripts/lab.mjs stages",
    "stage": "node scripts/lab.mjs stage",
    "referee": "node scripts/lab.mjs referee",
    "mutate": "node scripts/lab.mjs mutate",
    "restore": "node scripts/lab.mjs restore"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.19.0",
    "eslint": "10.12.0",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "secretlint": "13.0.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "lodash": "4.18.1"
  }
}
